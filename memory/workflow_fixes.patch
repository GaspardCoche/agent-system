             gh issue close "$NUM" --repo ${{ github.repository }} 2>/dev/null || true
           done
 
+      - name: Write Iris result artifact
+        if: always()
+        run: |
+          python3 -c "
+          import json
+          json.dump({'agent':'iris','task_id':'${{ github.run_id }}','status':'complete','summary':'Daily digest run','artifacts':[],'next_agent':None,
+            'retrospective':{'what_worked':'digest pipeline executed','what_failed':'','mcp_patterns':[],'improvement_suggestion':''}}, open('/tmp/agent_result.json','w'))
